# Copy this file to frontend/.env before the first run:
#   cp frontend/.env.example frontend/.env      (Windows: copy frontend\.env.example frontend\.env)

# Leave both empty: the dev server forwards /api and /ws to the backend
# on port 4000, and in production Nginx serves both from the same domain.
VITE_API_URL=
VITE_WS_URL=

# Optional — only needed to test Google sign-in locally.
VITE_GOOGLE_CLIENT_ID=
