generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// SQLite — single file on the VPS (backend/onlyfunds.db), backed up by
// deploy/backup.sh. Previously Postgres on Railway; every field in this
// schema (String/Int/Float/Boolean/DateTime/Json) is SQLite-compatible.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?   // optional — Google-only users have no password
  googleId         String?   @unique // populated when account is linked to a Google login
  avatarUrl        String?   // pulled from Google profile when available
  name             String?
  displayName      String?
  mobile           String?
  phoneCountry     String?
  role             String    @default("user")
  status           String    @default("active") // 'active' | 'pending' | 'rejected' | 'suspended'
  telegramBotToken String?
  telegramChatId   String?
  // Scheduled Reports
  reportEnabled    Boolean   @default(false)
  reportFrequency  String    @default("daily")
  reportTime       String    @default("20:00")
  reportDay        Int       @default(1)
  // Preferences
  language         String    @default("en")
  theme            String    @default("dark")
  timezone         String    @default("Asia/Bangkok")
  // Live ticker symbols (JSON array of strings). Null = use server default.
  tickerSymbols    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  accounts         Account[]
  accountGroups    AccountGroup[]
  notificationLogs NotificationLog[]
  auditLogs        AuditLog[]
}

model AccountGroup {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#6b7280")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Account {
  id            String   @id @default(uuid())
  name          String
  broker        String
  accountNumber String
  apiKey        String   @unique
  server        String   @default("Unknown")
  currency      String   @default("USD")
  leverage      Int      @default(100)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       String?
  group         AccountGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Alert thresholds (null = disabled)
  alertDrawdown    Float?
  alertEquityBelow Float?
  alertMarginLevel Float?
  alertOffline     Boolean  @default(false)
  // Demo / sandbox flag
  isDemo             Boolean  @default(false)
  // Drawdown Protection
  protectionEnabled  Boolean  @default(false)
  protectionDrawdown Float?
  // Last snapshot the EA pushed. Persisted so a restarted API shows the
  // figures this account really had, instead of placeholder money — an
  // account whose EA is offline used to come back reading 1,000.
  balance           Float     @default(0)
  equity            Float     @default(0)
  margin            Float     @default(0)
  freeMargin        Float     @default(0)
  marginLevel       Float     @default(0)
  profit            Float     @default(0)
  drawdown          Float     @default(0)
  openLots          Float     @default(0)
  buyLots           Float     @default(0)
  sellLots          Float     @default(0)
  pendingOrders     Int       @default(0)
  todayPnl          Float?
  closedOrdersToday Int?
  brokerTimeOffset  Int?
  /// When that snapshot arrived — null means the EA has never connected.
  lastPushAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  equitySnapshots  EquitySnapshot[]
  closedTrades     ClosedTrade[]

  @@index([userId])
  @@index([apiKey])
  @@index([groupId])
}

model EquitySnapshot {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equity    Float
  balance   Float
  drawdown  Float
  timestamp DateTime @default(now())

  @@index([accountId, timestamp])
  @@index([accountId])
}

model ClosedTrade {
  id         String   @id @default(uuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket     Int
  symbol     String
  type       String
  lots       Float
  openPrice  Float
  closePrice Float
  profit     Float
  swap       Float    @default(0)
  commission Float    @default(0)
  openTime   DateTime
  closeTime  DateTime @default(now())
  sl         Float    @default(0)
  tp         Float    @default(0)

  @@unique([accountId, ticket])
  @@index([accountId, closeTime])
  @@index([accountId])
}

model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  type      String
  message   String
  success   Boolean  @default(true)
  sentAt    DateTime @default(now())

  @@index([userId, sentAt])
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

/// A thing in the repository — an EA, an indicator, a script. Its screenshots,
/// presets and older builds hang off it, so a preset is never orphaned from the
/// build it belongs to.
model EaItem {
  id          String   @id @default(uuid())
  name        String
  /// One or more of: MT5 EA | MT4 EA | Indicator | Script | Source | Other,
  /// comma separated. Stored the way tags are — an entry is often two things
  /// at once (an EA and its source), and the single value could not say so.
  /// Rows written before this held exactly one, which parses as a list of one.
  type        String
  /// OK | Waiting | Other — where this entry stands, at a glance.
  status      String   @default("OK")
  description String   @default("")
  /// Free-form labels, comma separated. A join table buys nothing while the
  /// list is small enough to filter in memory, and costs a migration to add.
  tags        String   @default("")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images EaImage[]
  files  EaFile[]
}

/// Screenshot. `storedName` is the name on disk; the original is kept for
/// display and for the download filename.
model EaImage {
  id         String   @id @default(uuid())
  itemId     String
  item       EaItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storedName String
  filename   String
  caption    String   @default("")
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([itemId])
}

model EaFile {
  id         String   @id @default(uuid())
  itemId     String
  item       EaItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storedName String
  filename   String
  /// What this file is: "Current build", "Preset", "Previous build".
  label      String   @default("")
  size       Int
  createdAt  DateTime @default(now())

  @@index([itemId])
}
