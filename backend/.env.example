# Copy this file to backend/.env before the first run:
#   cp backend/.env.example backend/.env        (Windows: copy backend\.env.example backend\.env)
# backend/.env is ignored by git — your secrets stay on your machine.

PORT=4000

# Local development secrets. The VPS generates real random ones in setup.sh.
JWT_SECRET=onlyfunds_dev_secret
ENCRYPTION_KEY=onlyfunds_dev_encryption_key

# SQLite database file, created by `npx prisma db push`.
# The path is relative to backend/prisma/.
DATABASE_URL="file:./dev.db"

# Optional — only needed to test Google sign-in locally.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── Outbound email (approval, rejection, password reset) ────────────────────
# Leave both routes empty and nothing is sent — the app logs what it would
# have sent and carries on.
#
# Preferred: Resend, over HTTPS. DigitalOcean blocks outbound 25/465/587 on
# new droplets, so SMTP cannot leave this host at all; an HTTP API can.
# Key from https://resend.com/api-keys. Without a verified domain, MAIL_FROM
# must be onboarding@resend.dev and mail can only go to your own address.
RESEND_API_KEY=

# Brevo, also over HTTPS. Worth having because it will send from a single
# verified address — a plain Gmail address, verified by clicking a link in
# it — so mail can reach other people before you own a domain, which
# Resend's shared test domain cannot do. Key from
# https://app.brevo.com/settings/keys/api, sender at Senders → Add a sender,
# and MAIL_FROM must be that exact address.
# Sending as gmail.com through Brevo does not align SPF or DKIM with Gmail,
# so expect the spam folder sometimes. A domain of your own is still the fix.
BREVO_API_KEY=

# Which one to use, when more than one is filled in: resend | brevo | smtp.
# Leave empty and the first configured one wins, in that order. This is the
# switch — change it, restart, and the next email goes the other way.
MAIL_PROVIDER=

# Fallback: any SMTP server, used only when no HTTP provider is configured.
# Gmail: SMTP_PASS must be a 16-character App Password from
# https://myaccount.google.com/apppasswords — not your Google password, and
# 2-Step Verification has to be on before that page will offer one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OnlyFunds <your.address@gmail.com>
SITE_URL=https://onlyfunds.duckdns.org

# ── AI assistant ────────────────────────────────────────────────────────────
# Off until AI_API_KEY is set: the screens say so plainly and nothing is sent
# anywhere. Which company answers is one variable — the rest of the app does
# not know or care.
#
#   anthropic   console.anthropic.com        default model claude-sonnet-5
#   openai      platform.openai.com          default model gpt-4o-mini
#   google      aistudio.google.com          default model gemini-2.0-flash
#   openrouter  openrouter.ai                one key, every model above
#
# The portfolio (balances, open positions, 30 days of figures) is sent with
# each question, and photos when they are attached. Nothing else leaves.
AI_PROVIDER=anthropic
AI_MODEL=
AI_API_KEY=
# Only for a proxy or a test double; leave empty for the real thing.
AI_API_BASE=
