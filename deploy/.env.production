# ============================================
# DOI DASH — Production environment variables
# setup.sh generates /opt/doi-dash/backend/.env for you.
# This file is only a reference for what goes in it.
# ============================================

PORT=4000
NODE_ENV=production

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# Encrypts stored Telegram bot tokens. Generate the same way.
ENCRYPTION_KEY=CHANGE_ME_ANOTHER_SECRET

# Comma-separated allowed origins — your dashboard URL
CORS_ORIGIN=https://YOUR_DOMAIN

# SQLite file. Absolute path so it does not depend on the working directory.
DATABASE_URL="file:/opt/doi-dash/backend/doi-dash.db"

# Optional — only if you use Google sign-in
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
